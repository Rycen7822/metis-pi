{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "incremental": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  }
}
