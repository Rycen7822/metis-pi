diff --git a/packages/coding-agent/test/interactive-mode-cache-notice.test.ts b/packages/coding-agent/test/interactive-mode-cache-notice.test.ts
new file mode 100644
index 0000000..c57181b
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-cache-notice.test.ts
@@ -0,0 +1,59 @@
+import type { AssistantMessage } from "@earendil-works/pi-ai";
+import { Container } from "@earendil-works/pi-tui";
+import { expect, test, vi } from "vitest";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+
+function assistant(cacheRead: number, cacheWrite: number, timestamp: number): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "test",
+		usage: {
+			input: 0,
+			output: 10,
+			cacheRead,
+			cacheWrite,
+			totalTokens: cacheRead + cacheWrite + 10,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp,
+	};
+}
+
+test("a live assistant cache miss can be shown without copying the entire session history", async () => {
+	initTheme("dark");
+	const sessionManager = SessionManager.inMemory(process.cwd());
+	sessionManager.appendMessage(assistant(106_000, 0, 61_000));
+	vi.spyOn(sessionManager, "getEntriesMetadata").mockImplementation(() => {
+		throw new Error("full history copy");
+	});
+	const chatContainer = new Container();
+	const mode = Object.assign(Object.create(InteractiveMode.prototype), {
+		isInitialized: true,
+		streamingComponent: { updateContent() {} },
+		pendingTools: new Map(),
+		footer: { invalidate() {} },
+		programStatus: { handleEvent() {} },
+		ui: { requestRender() {} },
+		maybeSuggestBugReport() {},
+		maybeShowThinkingDropNotice() {},
+		chatContainer,
+		runtimeHost: {
+			session: {
+				sessionManager,
+				settingsManager: { getNotices: () => ({ cacheMisses: true }) },
+				modelRuntime: { getModel: () => ({ cost: { cacheRead: 0.3 } }) },
+			},
+		},
+	});
+
+	await mode.handleEvent({ type: "message_end", message: assistant(0, 110_000, 600_000) });
+
+	expect(stripAnsi(chatContainer.render(120).join("\n"))).toContain("Cache miss after 9m idle: 106k tokens re-billed");
+});
