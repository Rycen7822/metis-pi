+/** Resolve zero-width column markers only for physical output, after clipping and overlays. */
+export function serializeScrollbarAnchors(line: string, terminalWidth = 0): string {
+	return line.replace(/\x1b_pi:sb:(\d+)\x07/g, (_, digits: string) => {
+		const column = Number(digits);
+		return column > 0 && column <= terminalWidth ? `\x1b[${column}G` : "";
+	});
+}
+
 function paintScrollbar(box: LayoutBox, screen: string[], totalWidth: number): void {
 	const geometry = getScrollbarGeometry(box);
 	if (!geometry || !box.scrollView) return;
 
+	const anchor = `\x1b_pi:sb:${geometry.column + 1}\x07`;
 	for (let offset = 0; offset < geometry.trackHeight; offset++) {
 		const row = geometry.trackTop + offset;
 		if (row < box.clip.y || row >= box.clip.y + box.clip.height || row < 0 || row >= screen.length) continue;
@@ -343,7 +352,7 @@ function paintScrollbar(box: LayoutBox, screen: string[], totalWidth: number): v
 			screen[row] ?? "",
 			geometry.column,
 			totalWidth,
-			replacement,
+			anchor + replacement,
 			box.scrollView.scrollbar !== "always",
 		);
 	}
