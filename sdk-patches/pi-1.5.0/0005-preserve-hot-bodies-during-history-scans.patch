+	it("scan misses do not evict hot interactive bodies or enter the cache", () => {
+		const seed = SessionManager.create(tempDir, tempDir);
+		const hotId = seed.appendMessage(userMsg("hot interactive source"));
+		// Two serialized bodies exceed the 16MiB cache; ordinary admission would evict the hot entry.
+		const firstId = seed.appendCustomEntry("cold", { text: "x".repeat(9 * 1024 * 1024) });
+		const secondId = seed.appendCustomEntry("cold", { text: "界".repeat(3 * 1024 * 1024) });
+		const file = seed.getSessionFile();
+		if (!file) throw new Error("Expected session file");
+		const session = SessionManager.open(file);
+		const hot = session.getEntry(hotId);
+		expect(session.getEntryForScan(hotId)).toBe(hot);
+		const first = session.getEntryForScan(firstId);
+		expect(first).toMatchObject({ type: "custom", customType: "cold", data: { text: "x".repeat(9 * 1024 * 1024) } });
+		expect(session.getEntryForScan(secondId)).toMatchObject({ data: { text: "界".repeat(3 * 1024 * 1024) } });
+		expect(session.getEntry(hotId)).toBe(hot);
+		const retained = session.getEntry(firstId);
+		expect(retained).toEqual(first);
+		expect(retained).not.toBe(first);
+		expect(session.getEntryForScan(firstId)).toBe(retained);
+		session.getEntry(secondId);
+		expect(session.getEntry(hotId)).not.toBe(hot);
+	});
+
+	it("scan reads preserve in-memory identity and missing-entry behavior", () => {
+		const session = SessionManager.inMemory(tempDir);
