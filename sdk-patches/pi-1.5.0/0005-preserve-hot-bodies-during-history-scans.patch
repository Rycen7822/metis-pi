+			const id = seed.appendMessage(userMsg("persisted evidence"));
+			const file = seed.getSessionFile();
+			if (!file) throw new Error("Expected session file");
+			const bytes = readFileSync(file, "utf8");
+			const session = SessionManager.open(file);
+			if (kind === "truncated") {
+				writeFileSync(file, "");
+				expect(() => session.getEntryForScan(id)).toThrow(/truncated/);
+			} else if (kind === "changed") {
+				const replacement = `${id.startsWith("0") ? "1" : "0"}${id.slice(1)}`;
+				writeFileSync(file, bytes.replace(`"id":"${id}"`, `"id":"${replacement}"`));
+				expect(() => session.getEntryForScan(id)).toThrow(/changed on disk/);
+			} else {
+				const bodyStart = bytes.indexOf("\n") + 1;
+				writeFileSync(file, `${bytes.slice(0, bodyStart)}!${bytes.slice(bodyStart + 1)}`);
+				expect(() => session.getEntryForScan(id)).toThrow(SyntaxError);
+			}
+		},
+	);
