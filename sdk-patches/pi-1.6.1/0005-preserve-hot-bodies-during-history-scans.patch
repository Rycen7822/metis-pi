@@ -353,6 +359,115 @@ describe("TreeSelectorComponent", () => {
 		});
 	});
 
+	describe("disk-backed search keeps hot bodies", () => {
+		test("two cold custom messages are scanned without evicting or admitting bodies", async () => {
+			const directory = mkdtempSync(join(tmpdir(), "pi-tree-scan-"));
+			try {
+				const seed = SessionManager.create(directory, directory);
+				const hotId = seed.appendMessage({ role: "user", content: "hot context body", timestamp: 1 });
+				// Serialized bodies are about 9 MiB each: retaining both would evict the hot entry.
+				const firstCold = `first ${"x".repeat(9 * 1024 * 1024)}`;
+				const secondCold = `second ${"界".repeat(3 * 1024 * 1024)} tail-marker-second`;
+				const coldOne = seed.appendCustomMessageEntry("cold", firstCold, true);
+				const coldTwo = seed.appendCustomMessageEntry("cold", secondCold, true);
+				const file = seed.getSessionFile();
+				if (!file) throw new Error("Expected session file");
+
+				const run = async (query: string, userOnly: boolean) => {
+					const session = SessionManager.open(file);
+					const hot = session.getEntry(hotId);
+					const source = session.getTreeSource();
+					const scans: string[] = [];
+					const scanned = new Map<string, SessionEntry | undefined>();
+					const scan = source.readEntryForScan;
+					source.readEntryForScan = (id) => {
+						scans.push(id);
+						const entry = scan?.(id);
+						scanned.set(id, entry);
+						return entry;
+					};
+					const selector = new TreeSelectorComponent(
+						source,
+						coldTwo,
+						24,
+						() => {},
+						() => {},
+					);
+					if (userOnly) selector.handleInput("\x15");
+					selector.handleInput(query);
+					await new Promise<void>((resolve) => setImmediate(resolve));
+					const list = selector.getTreeList();
+					const matches = () => {
+						const ids: string[] = [];
+						for (let index = 0; index < 200; index++) {
+							const node = list.getSelectedReference();
+							if (node) ids.push(node.entry.id);
+							selector.handleInput("\x1b[B");
+						}
+						return new Set(ids);
+					};
+					const matched = query && !userOnly ? matches() : new Set<string>();
+					expect(session.getEntry(hotId)).toBe(hot);
+					return { session, hot, scans, scanned, matched, coldOne, coldTwo };
+				};
+
+				const none = await run("zzz-absent-token", false);
+				expect(none.matched.size).toBe(0);
+				expect(none.scans).toEqual(expect.arrayContaining([none.coldOne, none.coldTwo]));
+				expect(none.scanned.get(none.coldTwo)).toEqual(expect.objectContaining({ type: "custom_message" }));
+				// Cold scan bodies were not admitted: an ordinary read decodes a different object.
+				expect(none.session.getEntry(none.coldOne)).not.toBe(none.scanned.get(none.coldOne));
+
+				const second = await run("tail-marker-second", false);
+				expect([...second.matched]).toEqual([second.coldTwo]);
+				expect(second.scans).toEqual(expect.arrayContaining([second.coldOne, second.coldTwo]));
+
+				const hot = await run("hot context", false);
+				expect([...hot.matched]).toEqual([hotId]);
+				// Every default-filter search reads the cold candidates; the hot object keeps identity.
+				expect(hot.scans).toEqual(expect.arrayContaining([hot.coldOne, hot.coldTwo]));
+
+				const userOnly = await run("tail-marker-second", true);
+				expect(userOnly.scans).not.toContain(userOnly.coldOne);
+				expect(userOnly.scans).not.toContain(userOnly.coldTwo);
+			} finally {
+				rmSync(directory, { recursive: true, force: true });
+			}
+		});
+
+		test("legacy retaining search produces the same matches on disk-backed data", async () => {
+			const directory = mkdtempSync(join(tmpdir(), "pi-tree-legacy-"));
+			try {
+				const seed = SessionManager.create(directory, directory);
+				const userId = seed.appendMessage({ role: "user", content: "shared first", timestamp: 1 });
+				seed.appendCustomMessageEntry("cold", `alpha ${"y".repeat(2000)}`, true);
+				const target = seed.appendCustomMessageEntry("cold", "beta tail-marker-second", true);
+				const file = seed.getSessionFile();
+				if (!file) throw new Error("Expected session file");
+				const search = async (legacy: boolean) => {
+					const session = SessionManager.open(file);
+					const source = session.getTreeSource();
+					if (legacy) delete (source as { readEntryForScan?: unknown }).readEntryForScan;
+					const list = new TreeSelectorComponent(
+						source,
+						target,
+						24,
+						() => {},
+						() => {},
+					).getTreeList();
+					list.handleInput("tail-marker-second");
+					await new Promise<void>((resolve) => setImmediate(resolve));
+					return list.getSelectedReference()?.entry.id;
+				};
+				expect(await search(true)).toBe(target);
+				expect(await search(false)).toBe(target);
+				expect(userId).not.toBe(target);
+			} finally {
+				rmSync(directory, { recursive: true, force: true });
+			}
+		});
+	});
+
 	describe("initial selection with metadata entries", () => {
 		test("focuses nearest visible ancestor when currentLeafId is a model_change with sibling branch", () => {
 			// Tree structure:
