new file mode 100644
index 000000000..296af9c0c
--- /dev/null
+++ b/packages/coding-agent/src/extensions/codemode/call-tracker.ts
@@ -0,0 +1,68 @@
+import type { AgentToolResult } from "@earendil-works/pi-agent-core";
+import type { CodemodeNestedCall, CodemodeToolDetails } from "./tool.ts";
+
+/** Live previews are not the transcript: keep bounded rows and independent totals. */
+export class CodemodeCallTracker {
+	readonly calls: CodemodeNestedCall[] = [];
+	private readonly active = new Map<CodemodeNestedCall, boolean>();
+	private readonly summary = {
+		total: 0,
+		ok: 0,
+		error: 0,
+		cancelled: 0,
+		unfinished: 0,
+		cost: 0,
+	};
+	closed = false;
+
+	private readonly onUpdate: ((result: AgentToolResult<CodemodeToolDetails>) => void) | undefined;
+
+	constructor(onUpdate: ((result: AgentToolResult<CodemodeToolDetails>) => void) | undefined) {
+		this.onUpdate = onUpdate;
+	}
+
+	start(call: CodemodeNestedCall, dispatched = true): void {
+		call.sequence = this.summary.total;
+		this.active.set(call, dispatched);
+		this.summary.total++;
+		this.calls.push(call);
+		if (this.calls.length > 256) this.calls.shift();
+		this.publish();
+	}
+
+	dispatched(call: CodemodeNestedCall): void {
+		if (!this.closed && this.active.has(call)) this.active.set(call, true);
+	}
+
+	settle(
+		call: CodemodeNestedCall,
+		status: "ok" | "error" | "cancelled",
+		fields: Partial<Pick<CodemodeNestedCall, "id" | "durationMs" | "error" | "cost">>,
+	): void {
+		if (this.closed || !this.active.delete(call)) return;
+		Object.assign(call, fields, { status });
+		this.summary[status]++;
+		this.summary.cost += fields.cost ?? 0;
+		this.publish();
+	}
+
+	publish(): void {
+		if (!this.closed) this.onUpdate?.({ content: [], details: this.snapshot() });
+	}
+
+	close(): void {
+		this.closed = true;
+		for (const [call, dispatched] of this.active) {
+			call.status = dispatched ? "unfinished" : "cancelled";
+			this.summary[call.status]++;
+		}
+		this.active.clear();
+	}
+
+	snapshot(): CodemodeToolDetails & { callSummary: NonNullable<CodemodeToolDetails["callSummary"]> } {
+		return {
+			calls: this.calls.map((call) => ({ ...call })),
+			callSummary: { ...this.summary, running: this.active.size, omitted: this.summary.total - this.calls.length },
+		};
+	}
+}
