index 000000000..660c3cb85
--- /dev/null
+++ b/packages/coding-agent/src/core/session-file-reader.ts
@@ -0,0 +1,75 @@
+import { appendFileSync, closeSync, existsSync, openSync, readSync } from "fs";
+import { normalizePath } from "../utils/paths.ts";
+import type { FileEntry } from "./session-types.ts";
+
+// A 1 MiB scan buffer amortizes filesystem reads without retaining the whole transcript.
+const SESSION_SCAN_CHUNK_BYTES = 1024 * 1024;
+const NEWLINE_BYTE = 0x0a;
+
+export interface SessionEntryLocation {
+	/** UTF-8 byte offset and length, excluding the physical newline. */
+	offset: number;
+	length: number;
+}
+
+export function parseSessionEntryLine(line: string): FileEntry | null {
+	if (!line.trim()) return null;
+	try {
+		return JSON.parse(line) as FileEntry;
+	} catch {
+		return null;
+	}
+}
+
+/** Visits validated-session JSONL records one at a time; malformed lines retain the legacy skip contract. */
+export function scanSessionFile(
+	filePath: string,
+	visit: (entry: FileEntry, location: SessionEntryLocation) => void,
+): number {
+	const path = normalizePath(filePath);
+	if (!existsSync(path)) return 0;
+	let count = 0;
+	const accept = (bytes: Buffer, offset: number): boolean => {
+		const entry = parseSessionEntryLine(bytes.toString("utf8"));
+		if (!entry) return true;
+		if (count === 0 && (entry.type !== "session" || typeof entry.id !== "string")) return false;
+		visit(entry, { offset, length: bytes.length });
+		count++;
+		return true;
+	};
+	const fd = openSync(path, "r");
+	let parts: Buffer[] = [];
+	let fileOffset = 0;
+	let recordOffset = 0;
+	try {
+		const buffer = Buffer.allocUnsafe(SESSION_SCAN_CHUNK_BYTES);
+		while (true) {
+			const bytesRead = readSync(fd, buffer, 0, buffer.length, null);
+			if (bytesRead === 0) break;
+			let start = 0;
+			let end = buffer.indexOf(NEWLINE_BYTE, start);
+			while (end >= 0 && end < bytesRead) {
+				const tail = buffer.subarray(start, end);
+				let bytes = tail;
+				if (parts.length) {
+					parts.push(tail);
+					bytes = Buffer.concat(parts);
+				}
+				if (!accept(bytes, recordOffset)) return 0;
+				parts = [];
+				start = end + 1;
+				recordOffset = fileOffset + start;
+				end = buffer.indexOf(NEWLINE_BYTE, start);
+			}
+			// The scan buffer is reused; unfinished records must own their retained bytes.
+			if (start < bytesRead) parts.push(Buffer.from(buffer.subarray(start, bytesRead)));
+			fileOffset += bytesRead;
+		}
+		if (parts.length && !accept(Buffer.concat(parts), recordOffset)) return 0;
+	} finally {
+		closeSync(fd);
+	}
+	// Preserve loadEntriesFromFile's repair only after accepting a real session header.
+	if (count > 0 && parts.length) appendFileSync(path, "\n");
+	return count;
+}
