@@ -0,0 +1,111 @@
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import type {
+	BranchSummaryEntry,
+	CompactionEntry,
+	ContextEditEntry,
+	CustomEntry,
+	CustomMessageEntry,
+	LabelEntry,
+	ModelChangeEntry,
+	SessionEntry,
+	SessionEntryBase,
+	SessionInfoEntry,
+	ThinkingLevelChangeEntry,
+	UsageEntry,
+} from "./session-types.ts";
+
+/** Facts needed for settings and usage; content, signatures and tool payloads remain in the entry body. */
+export type SessionMessageMetadata =
+	| (Pick<
+			AssistantMessage,
+			"role" | "api" | "provider" | "model" | "responseModel" | "responseId" | "usage" | "stopReason" | "timestamp"
+	  > & {
+			toolCallCount: number;
+	  })
+	| Pick<ToolResultMessage, "role" | "usage">
+	| { role: Exclude<AgentMessage["role"], "assistant" | "toolResult"> };
+
+/** Body-free records for branch selection, state discovery and accounting. */
+export type SessionEntryMetadata = Readonly<
+	| (SessionEntryBase & { type: "message"; message: SessionMessageMetadata })
+	| ThinkingLevelChangeEntry
+	| ModelChangeEntry
+	| Omit<UsageEntry, "note">
+	| Omit<CompactionEntry, "summary" | "details" | "systemMessage">
+	| Omit<BranchSummaryEntry, "summary" | "details">
+	| Omit<CustomEntry, "data">
+	| Omit<CustomMessageEntry, "content" | "details">
+	| Omit<ContextEditEntry, "replacement">
+	| LabelEntry
+	| SessionInfoEntry
+	| (SessionEntryBase & { type: "unknown"; sourceType: string })
+>;
+
+export function toSessionEntryMetadata(entry: SessionEntry): SessionEntryMetadata {
+	const base = { id: entry.id, parentId: entry.parentId, timestamp: entry.timestamp };
+	const sourceType = entry.type;
+	switch (entry.type) {
+		case "message": {
+			let message: SessionMessageMetadata;
+			if (entry.message.role === "assistant") {
+				message = {
+					role: entry.message.role,
+					api: entry.message.api,
+					provider: entry.message.provider,
+					model: entry.message.model,
+					responseModel: entry.message.responseModel,
+					responseId: entry.message.responseId,
+					toolCallCount: Array.isArray(entry.message.content)
+						? entry.message.content.reduce((count, block) => count + (block.type === "toolCall" ? 1 : 0), 0)
+						: 0,
+					usage: entry.message.usage,
+					stopReason: entry.message.stopReason,
+					timestamp: entry.message.timestamp,
+				};
+			} else if (entry.message.role === "toolResult") {
+				message = { role: entry.message.role, usage: entry.message.usage };
+			} else {
+				message = { role: entry.message.role };
+			}
+			return { ...base, type: entry.type, message };
+		}
+		case "thinking_level_change":
+			return { ...base, type: entry.type, thinkingLevel: entry.thinkingLevel };
+		case "model_change":
+			return { ...base, type: entry.type, provider: entry.provider, modelId: entry.modelId };
+		case "usage":
+			return {
+				...base,
+				type: entry.type,
+				kind: entry.kind,
+				provider: entry.provider,
+				model: entry.model,
+				usage: entry.usage,
+			};
+		case "compaction":
+			return {
+				...base,
+				type: entry.type,
+				firstKeptEntryId: entry.firstKeptEntryId,
+				tokensBefore: entry.tokensBefore,
+				usage: entry.usage,
+				fromHook: entry.fromHook,
+			};
+		case "branch_summary":
+			return { ...base, type: entry.type, fromId: entry.fromId, usage: entry.usage, fromHook: entry.fromHook };
+		case "custom":
+			return { ...base, type: entry.type, customType: entry.customType };
+		case "custom_message":
+			return { ...base, type: entry.type, customType: entry.customType, display: entry.display };
+		case "context_edit":
+			return { ...base, type: entry.type, targetId: entry.targetId };
+		case "label":
+			return { ...base, type: entry.type, targetId: entry.targetId, label: entry.label };
+		case "session_info":
+			return { ...base, type: entry.type, name: entry.name };
+		default:
+			// Parsed files can contain newer entry types; preserve topology and leave their bodies readable.
+			return { ...base, type: "unknown", sourceType };
+	}
+}
