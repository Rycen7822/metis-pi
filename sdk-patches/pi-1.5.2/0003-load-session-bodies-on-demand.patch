new file mode 100644
index 000000000..f8c91d5de
--- /dev/null
+++ b/packages/coding-agent/src/core/session-entry-store.ts
@@ -0,0 +1,250 @@
+import { appendFileSync, closeSync, openSync, readSync, statSync, writeFileSync } from "fs";
+import { type SessionEntryMetadata, toSessionEntryMetadata } from "./session-entry-metadata.ts";
+import { type SessionEntryLocation, scanSessionFile } from "./session-file-reader.ts";
+import type { FileEntry, SessionEntry, SessionHeader } from "./session-types.ts";
+
+// Serialized UTF-8 bytes, not a JS heap limit; the measured active context is about 4.4 MiB.
+const MAX_CACHED_SESSION_ENTRY_BYTES = 16 * 1024 * 1024;
+// Reuse one bounded workspace for ordinary reads instead of churning native Buffer allocations per record.
+const MAX_REUSED_ENTRY_READ_BYTES = 1024 * 1024;
+
+interface StoredSessionEntry {
+	kind: "entry";
+	metadata: SessionEntryMetadata;
+	body?: SessionEntry;
+	location?: SessionEntryLocation;
+}
+
+type StoredRecord = StoredSessionEntry | { kind: "header"; header: SessionHeader };
+
+/** Owns record locations and bounded decoded bodies; returned entries remain ordinary, complete objects. */
+export class SessionEntryStore {
+	private records: StoredRecord[] = [];
+	private byId = new Map<string, StoredSessionEntry>();
+	private path?: string;
+	private cache = new Map<StoredSessionEntry, { entry: SessionEntry; bytes: number }>();
+	private cachedBytes = 0;
+	private entryReadBuffer?: Buffer;
+
+	constructor(entries: FileEntry[] = [], path?: string) {
+		this.path = path;
+		for (const entry of entries) this.add(entry);
+	}
+
+	static open(path: string): SessionEntryStore {
+		const store = new SessionEntryStore();
+		store.path = path;
+		scanSessionFile(path, (entry, location) => store.add(entry, location));
+		return store;
+	}
+
+	private add(entry: FileEntry, location?: SessionEntryLocation): void {
+		if (entry.type === "session") {
+			this.records.push({ kind: "header", header: entry });
+			return;
+		}
+		const record: StoredSessionEntry = {
+			kind: "entry",
+			metadata: toSessionEntryMetadata(entry),
+			location,
+			...(location ? {} : { body: entry }),
+		};
+		this.records.push(record);
+		this.byId.set(entry.id, record);
+	}
+
+	get size(): number {
+		return this.byId.size;
+	}
+	get fileEntryCount(): number {
+		return this.records.length;
+	}
+	has(id: string): boolean {
+		return this.byId.has(id);
+	}
+
+	getHeader(): SessionHeader | null {
+		const record = this.records.find((record) => record.kind === "header");
+		return record?.kind === "header" ? record.header : null;
+	}
+
+	/** A non-persistent branch fork keeps locations and currently cached bodies, not the complete history. */
+	createBranchPreview(branch: readonly SessionEntryMetadata[]): SessionEntryStore {
+		const preview = new SessionEntryStore([], this.path);
+		const header = this.getHeader();
+		if (header) preview.records.push({ kind: "header", header });
+		for (const metadata of branch) {
+			const record = this.byId.get(metadata.id);
+			if (!record) throw new Error(`Session entry not found: ${metadata.id}`);
+			// Copy envelopes: later persistence must not rebind this preview's source locations.
+			const snapshot = { ...record, body: record.body ?? this.cache.get(record)?.entry };
+			preview.records.push(snapshot);
+			preview.byId.set(metadata.id, snapshot);
+		}
+		return preview;
+	}
+
+	getMetadata(id: string): SessionEntryMetadata | undefined {
+		return this.byId.get(id)?.metadata;
+	}
+
+	getEntriesMetadata(): SessionEntryMetadata[] {
+		const entries: SessionEntryMetadata[] = [];
+		for (const record of this.records) if (record.kind === "entry") entries.push(record.metadata);
+		return entries;
+	}
+
+	*getIndexedMetadata(): IterableIterator<SessionEntryMetadata> {
+		for (const record of this.byId.values()) yield record.metadata;
+	}
+
+	getLastMetadata(type: SessionEntryMetadata["type"]): SessionEntryMetadata | undefined {
+		for (let index = this.records.length - 1; index >= 0; index--) {
+			const record = this.records[index];
+			if (record.kind === "entry" && record.metadata.type === type) return record.metadata;
+		}
+		return undefined;
+	}
+
+	readEntries(metadata: readonly SessionEntryMetadata[]): SessionEntry[] {
+		return metadata.map((entry) => {
+			const record = this.byId.get(entry.id);
+			if (!record) throw new Error(`Session entry not found: ${entry.id}`);
+			return this.read(record);
+		});
+	}
+
+	getEntry(id: string): SessionEntry | undefined {
+		const record = this.byId.get(id);
+		return record ? this.read(record) : undefined;
+	}
+
+	getEntries(): SessionEntry[] {
+		const entries: SessionEntry[] = [];
+		for (const record of this.records) if (record.kind === "entry") entries.push(this.read(record));
+		return entries;
+	}
+
+	getFileEntries(): FileEntry[] {
+		return this.records.map((record) => (record.kind === "header" ? record.header : this.read(record)));
+	}
+
+	append(entry: SessionEntry): void {
+		this.add(entry);
+	}
+
+	/** Undo the tail append after persistence fails; never discard a different or committed record. */
+	rollbackAppend(id: string): void {
+		const record = this.records.at(-1);
+		if (record?.kind !== "entry" || record.metadata.id !== id)
+			throw new Error("Cannot roll back a non-tail session entry");
+		this.records.pop();
+		this.byId.delete(id);
+		const cached = this.cache.get(record);
+		if (cached) {
+			this.cache.delete(record);
+			this.cachedBytes -= cached.bytes;
+		}
+	}
+
+	private read(record: StoredSessionEntry): SessionEntry {
+		if (record.body) return record.body;
+		const cached = this.cache.get(record);
+		if (cached) {
+			this.cache.delete(record);
+			this.cache.set(record, cached);
+			return cached.entry;
+		}
+		if (!this.path || !record.location) throw new Error(`Session entry has no body: ${record.metadata.id}`);
+		const { offset, length } = record.location;
+		let bytes: Buffer;
+		if (length <= MAX_REUSED_ENTRY_READ_BYTES) {
+			this.entryReadBuffer ??= Buffer.allocUnsafe(MAX_REUSED_ENTRY_READ_BYTES);
+			bytes = this.entryReadBuffer;
+		} else {
+			bytes = Buffer.allocUnsafe(length);
+		}
+		const fd = openSync(this.path, "r");
+		try {
+			let read = 0;
+			while (read < length) {
+				const count = readSync(fd, bytes, read, length - read, offset + read);
+				if (count === 0) throw new Error(`Session entry was truncated: ${record.metadata.id}`);
+				read += count;
+			}
+		} finally {
+			closeSync(fd);
+		}
+		const entry = JSON.parse(bytes.toString("utf8", 0, length)) as SessionEntry;
+		const expectedType = record.metadata.type === "unknown" ? record.metadata.sourceType : record.metadata.type;
+		if (!entry || entry.id !== record.metadata.id || entry.type !== expectedType) {
+			throw new Error(`Session entry changed on disk: ${record.metadata.id}`);
+		}
+		this.remember(record, entry, length);
+		return entry;
+	}
+
+	private remember(record: StoredSessionEntry, entry: SessionEntry, bytes: number): void {
+		const previous = this.cache.get(record);
+		if (previous) {
+			this.cachedBytes -= previous.bytes;
+			this.cache.delete(record);
+		}
+		if (bytes > MAX_CACHED_SESSION_ENTRY_BYTES) return;
+		while (this.cachedBytes + bytes > MAX_CACHED_SESSION_ENTRY_BYTES) {
+			const oldest = this.cache.entries().next().value;
+			if (!oldest) break;
+			this.cache.delete(oldest[0]);
+			this.cachedBytes -= oldest[1].bytes;
+		}
+		this.cache.set(record, { entry, bytes });
+		this.cachedBytes += bytes;
+	}
+
+	/** Rewrites explicitly materialize before truncation, so old offsets cannot refer into an overwritten source. */
+	writeToFile(path: string, flag: "w" | "wx"): void {
+		const files = this.records.map((record) =>
+			record.kind === "header"
+				? { kind: "header" as const, entry: record.header }
+				: { kind: "entry" as const, record, entry: this.read(record) },
+		);
+		const written: { record: StoredSessionEntry; entry: SessionEntry; location: SessionEntryLocation }[] = [];
+		let offset = 0;
+		const fd = openSync(path, flag);
+		try {
+			for (const file of files) {
+				const bytes = Buffer.from(`${JSON.stringify(file.entry)}\n`, "utf8");
+				writeFileSync(fd, bytes);
+				if (file.kind === "entry")
+					written.push({
+						record: file.record,
+						entry: file.entry,
+						location: { offset, length: bytes.length - 1 },
+					});
+				offset += bytes.length;
+			}
+		} finally {
+			closeSync(fd);
+		}
+		this.path = path;
+		this.cache.clear();
+		this.cachedBytes = 0;
+		for (const { record, entry, location } of written) {
+			record.location = location;
+			record.body = undefined;
+			this.remember(record, entry, location.length);
+		}
+	}
+
+	/** Persists an already-appended record and records its byte position without reparsing it. */
+	appendToFile(entry: SessionEntry): void {
+		const record = this.byId.get(entry.id);
+		if (!this.path || !record) throw new Error(`Session entry is not ready to persist: ${entry.id}`);
+		const bytes = Buffer.from(`${JSON.stringify(entry)}\n`, "utf8");
+		const offset = statSync(this.path).size;
+		appendFileSync(this.path, bytes);
+		record.location = { offset, length: bytes.length - 1 };
+		record.body = undefined;
+		this.remember(record, entry, record.location.length);
+	}
+}
diff --git a/packages/coding-agent/src/core/session-file-reader.ts b/packages/coding-agent/src/core/session-file-reader.ts
