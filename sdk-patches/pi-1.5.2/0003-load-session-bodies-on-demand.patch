+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { SessionManager } from "../../src/core/session-manager.ts";
+import { userMsg } from "../utilities.ts";
+
+describe("persisted session body cache", () => {
+	let directory: string;
+
+	beforeEach(() => {
+		directory = mkdtempSync(join(tmpdir(), "pi-lazy-bodies-"));
+	});
+
+	afterEach(() => rmSync(directory, { recursive: true, force: true }));
+
+	it("reads complete multi-chunk UTF-8 records and the following small record", () => {
+		const seed = SessionManager.create(directory, directory);
+		const content = "界🙂é".repeat(180_000);
+		const largeId = seed.appendMessage(userMsg(content));
+		const smallId = seed.appendMessage(userMsg("following 界🙂é record"));
+		const file = seed.getSessionFile()!;
+		// Preserve native CRLF and missing-final-newline handling across byte-offset reads.
+		writeFileSync(file, readFileSync(file, "utf8").trimEnd().replaceAll("\n", "\r\n"));
+		const session = SessionManager.open(file);
+
+		expect(session.getEntry(largeId)).toMatchObject({ message: { content } });
+		expect(session.getEntry(smallId)).toMatchObject({ message: { content: "following 界🙂é record" } });
+		expect(session.getBranchMetadata().map((entry) => entry.id)).toEqual([largeId, smallId]);
+		expect(JSON.stringify(session.getEntriesMetadata())).not.toContain("界🙂é");
+		expect(readFileSync(file, "utf8").endsWith("\n")).toBe(true);
+	});
+
+	it("accounts UTF-8 bytes and evicts the least recently used body", () => {
+		const seed = SessionManager.create(directory, directory);
+		seed.appendMessage(userMsg("start persistence"));
+		// Each body is about 6 MiB serialized but only 2 Mi UTF-16 units; three exceed 16 MiB.
+		const payload = "界".repeat(2 * 1024 * 1024);
+		const ids = Array.from({ length: 3 }, () => seed.appendCustomEntry("large", { payload }));
+		const session = SessionManager.open(seed.getSessionFile()!);
+		const first = session.getEntry(ids[0]);
+		const second = session.getEntry(ids[1]);
+		expect(session.getEntry(ids[0])).toBe(first);
+		expect(session.getEntry(ids[2])).toMatchObject({ data: { payload } });
+		expect(session.getEntry(ids[0])).toBe(first);
+
+		const reloaded = session.getEntry(ids[1]);
+		expect(reloaded).toEqual(second);
+		expect(reloaded).not.toBe(second);
+	});
+
+	it("returns an over-budget body intact without caching it or evicting a hot body", () => {
+		const seed = SessionManager.create(directory, directory);
+		const hotId = seed.appendMessage(userMsg("hot body"));
+		const payload = "界".repeat(6 * 1024 * 1024);
+		const largeId = seed.appendCustomEntry("oversized", { payload });
+		const session = SessionManager.open(seed.getSessionFile()!);
+		const hot = session.getEntry(hotId);
+		const first = session.getEntry(largeId);
+		const second = session.getEntry(largeId);
+
+		expect(first).toMatchObject({ data: { payload } });
+		expect(second).toEqual(first);
+		expect(second).not.toBe(first);
+		expect(session.getEntry(hotId)).toBe(hot);
+	});
+
+	it.each([1, 2])("migrates on-disk v%i bodies before rebinding their locations", (version) => {
+		const file = join(directory, "legacy.jsonl");
+		const timestamp = "2025-01-01T00:00:00Z";
+		const entries = [
+			{ type: "session", version, id: "legacy", timestamp, cwd: directory },
+			{ type: "message", id: "user", parentId: null, timestamp, message: userMsg("legacy 界🙂é") },
+			{
+				type: "message",
+				id: "hook",
+				parentId: "user",
+				timestamp,
+				message: { role: "hookMessage", customType: "memo", content: "hook 界🙂é", display: true, timestamp: 1 },
+			},
+		];
+		writeFileSync(file, `${entries.map((entry) => JSON.stringify(entry)).join("\n")}\n`);
+		const migrated = SessionManager.open(file);
+		const bodies = migrated.getEntries();
+
+		expect(migrated.getHeader()?.version).toBe(3);
+		expect(bodies[0]).toMatchObject({ parentId: null, message: { role: "user", content: "legacy 界🙂é" } });
+		expect(bodies[1]).toMatchObject({
+			parentId: bodies[0].id,
+			message: { role: "custom", content: "hook 界🙂é" },
+		});
+		const reopened = SessionManager.open(file);
+		expect(reopened.getEntries()).toEqual(bodies);
+		const nextId = reopened.appendMessage(userMsg("after migration"));
+		expect(SessionManager.open(file).getEntry(nextId)?.parentId).toBe(bodies[1].id);
+	});
+});
