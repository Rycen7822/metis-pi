+export async function searchSessionFiles(
+	sessions: SessionInfo[],
+	query: string,
+	sortMode: SortMode,
+	readText: SessionSearchReader,
+	signal: AbortSignal,
+): Promise<SessionInfo[]> {
+	const parsed = parseSearchQuery(query);
+	if (parsed.error) return [];
+	const scored: ScoredSession[] = [];
+	for (const session of sessions) {
+		signal.throwIfAborted();
+		const allMessagesText = await readText(session.path, signal);
