diff --git a/packages/coding-agent/src/core/session-tree-preview.ts b/packages/coding-agent/src/core/session-tree-preview.ts
new file mode 100644
index 000000000..04be69b89
--- /dev/null
+++ b/packages/coding-agent/src/core/session-tree-preview.ts
@@ -0,0 +1,51 @@
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+
+// Preserve the native tree's message search/display prefix, measured in UTF-16 code units.
+export const SESSION_TREE_PREVIEW_CHARS = 200;
+
+export interface SessionTreeMessagePreview {
+	readonly content: string;
+	readonly hasText: boolean;
+	readonly toolCalls: readonly { readonly id: string; readonly contentIndex: number }[];
+}
+
+/** Build only bounded text and tool locations while the scanner already has the complete message. */
+export function createSessionTreeMessagePreview(message: AgentMessage): SessionTreeMessagePreview {
+	const content = "content" in message ? message.content : undefined;
+	let prefix = "";
+	let hasText = false;
+	const toolCalls: { id: string; contentIndex: number }[] = [];
+	if (typeof content === "string") {
+		prefix = content.slice(0, SESSION_TREE_PREVIEW_CHARS);
+		hasText = content.trim().length > 0;
+	} else if (Array.isArray(content)) {
+		for (let index = 0; index < content.length; index++) {
+			const block = content[index];
+			if (typeof block !== "object" || block === null || !("type" in block)) continue;
+			if (block.type === "text") {
+				const text = (block as { text?: string }).text;
+				if (typeof text === "string" && text.trim().length > 0) hasText = true;
+				if (prefix.length < SESSION_TREE_PREVIEW_CHARS) {
+					prefix += String(text).slice(0, SESSION_TREE_PREVIEW_CHARS - prefix.length);
+				}
+			} else if (message.role === "assistant" && block.type === "toolCall") {
+				toolCalls.push({ id: (block as { id: string }).id, contentIndex: index });
+			}
+		}
+	}
+	// Detach a possible slice from a large parent; UTF-16 also preserves a cut surrogate exactly.
+	return { content: Buffer.from(prefix, "utf16le").toString("utf16le"), hasText, toolCalls };
+}
+
+/** Native tree copy semantics: concatenate text blocks without truncating or normalizing their contents. */
+export function extractSessionText(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	let result = "";
+	for (const block of content) {
+		if (typeof block === "object" && block !== null && "type" in block && block.type === "text") {
+			result += (block as { text: string }).text;
+		}
+	}
+	return result;
+}
