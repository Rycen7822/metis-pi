+	/** Capture a boundary view without reading bodies or adopting later branch appends. */
+	captureBoundaryProjection(): Pick<SessionProjection, "entries" | "messages"> {
+		const store = this.store,
+			leaf = this.leafId,
+			epoch = store.projectionEpoch,
+			source = this.sessionFile;
+		let path: SessionEntryMetadata[] | undefined;
+		let scoped: SessionProjection | undefined;
+		let entries: ProjectedSessionEntry[] | undefined;
+		const capturedPath = () => {
+			if (store.projectionEpoch !== epoch || (this.store !== store && this.sessionFile === source)) {
+				throw new SessionEntryStoreChangedError();
+			}
+			return (path ??= this.branchMetadata(store, leaf));
+		};
+		const messageProjection = () => {
+			if (scoped) return scoped;
+			const branch = capturedPath();
+			return (scoped = projectContextEntries(
+				store.readProjectionEntries(selectProjectionEntries(branch, "message-sources"), branch),
+				getSessionContextSettings(branch),
+			));
+		};
+		return {
+			get messages() {
+				return messageProjection().messages;
+			},
+			get entries() {
+				if (entries) return entries;
+				const branch = capturedPath();
+				if (!scoped) {
+					scoped = projectContextEntries(
+						store.readProjectionEntries(selectContextEntries(branch), branch),
+						getSessionContextSettings(branch),
+					);
+					return (entries = scoped.entries);
+				}
+				const selected = selectContextEntries(branch);
+				const existing = new Map(scoped.entries.map((entry) => [entry.sourceEntry.id, entry]));
+				const missing = store.readProjectionEntries(
+					selected.filter((entry) => !existing.has(entry.id)),
+					branch,
+				);
+				for (const sourceEntry of missing) existing.set(sourceEntry.id, { sourceEntry, messages: [] });
+				return (entries = selected.map((entry) => existing.get(entry.id)!));
+			},
+		};
+	}
