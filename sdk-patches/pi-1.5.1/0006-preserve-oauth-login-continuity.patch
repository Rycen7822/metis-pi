diff --git a/packages/ai/test/oauth-continuity.test.ts b/packages/ai/test/oauth-continuity.test.ts
new file mode 100644
index 000000000..15c061586
--- /dev/null
+++ b/packages/ai/test/oauth-continuity.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it, vi } from "vitest";
+import { InMemoryCredentialStore } from "../src/auth/credential-store.ts";
+import type { OAuthCredential } from "../src/auth/types.ts";
+import { createModels } from "../src/models.ts";
+import { openaiProvider } from "../src/providers/openai.ts";
+
+function fixture() {
+	const credentials = new InMemoryCredentialStore();
+	const initial: OAuthCredential = {
+		type: "oauth",
+		access: "opaque-access",
+		refresh: "opaque-refresh",
+		expires: Date.now() + 3_600_000,
+	};
+	let rotations = 0;
+	const refresh = vi.fn(async (current: OAuthCredential) => ({
+		...current,
+		access: `access-${++rotations}`,
+		refresh: `refresh-${rotations}`,
+		expires: Date.now() + 3_600_000,
+	}));
+	const provider = {
+		...openaiProvider(),
+		auth: {
+			oauth: {
+				name: "Offline OAuth",
+				login: async () => initial,
+				refresh,
+				toAuth: async (credential: OAuthCredential) => ({ apiKey: credential.access }),
+			},
+		},
+	};
+	const instance = () => {
+		const models = createModels({ credentials });
+		models.setProvider(provider);
+		return models;
+	};
+	const models = instance();
+	const login = () => models.login("openai", "oauth", { prompt: async () => "", notify() {} });
+	const expire = () =>
+		credentials.modify("openai", async (current) => ({ ...(current as OAuthCredential), expires: 0 }));
+	return { credentials, initial, refresh, instance, models, login, expire };
+}
+
+describe("OAuth login continuity", () => {
+	it("reads legacy credentials without rewriting storage", async () => {
+		const h = fixture();
+		await h.credentials.modify("openai", async () => h.initial);
+		const first = await h.models.getAuth("openai");
+		const second = await h.instance().getAuth("openai");
+		expect(first?.oauthSessionId).toEqual(expect.any(String));
+		expect(second?.oauthSessionId).toBe(first?.oauthSessionId);
+		expect(await h.credentials.read("openai")).toEqual(h.initial);
+		expect(h.refresh).not.toHaveBeenCalled();
+	});
+
+	it("keeps opaque legacy ownership through the first native refresh and reload", async () => {
+		const h = fixture();
+		await h.credentials.modify("openai", async () => h.initial);
+		const before = await h.models.getAuth("openai");
+		await h.expire();
+		const refreshed = await h.models.getAuth("openai");
+		const reloaded = await h.instance().getAuth("openai");
+		expect(refreshed?.auth.apiKey).not.toBe(before?.auth.apiKey);
+		expect(refreshed?.oauthSessionId).toBe(before?.oauthSessionId);
+		expect(reloaded?.oauthSessionId).toBe(before?.oauthSessionId);
+		expect(h.refresh).toHaveBeenCalledTimes(1);
+	});
+
+	it("shares a single locked refresh between independent clients", async () => {
+		const h = fixture();
+		await h.login();
+		const before = await h.models.getAuth("openai");
+		await h.expire();
+		const results = await Promise.all([h.models.getAuth("openai"), h.instance().getAuth("openai")]);
+		expect(h.refresh).toHaveBeenCalledTimes(1);
+		for (const result of results) {
+			expect(result?.auth.apiKey).toBe("access-1");
+			expect(result?.oauthSessionId).toBe(before?.oauthSessionId);
+		}
+	});
+
+	it("starts a new ownership on re-login even when tokens are identical", async () => {
+		const h = fixture();
+		await h.login();
+		const before = await h.models.getAuth("openai");
+		await h.login();
+		const after = await h.models.getAuth("openai");
+		expect(after?.auth.apiKey).toBe(before?.auth.apiKey);
+		expect(after?.oauthSessionId).not.toBe(before?.oauthSessionId);
+	});
+
+	it("does not revive ownership after logout and re-login", async () => {
+		const h = fixture();
+		await h.login();
+		const before = await h.models.getAuth("openai");
+		await h.models.logout("openai");
+		expect(await h.models.getAuth("openai")).toBeUndefined();
+		await h.login();
+		expect((await h.models.getAuth("openai"))?.oauthSessionId).not.toBe(before?.oauthSessionId);
+	});
+
+	it.each(["access", "refresh"] as const)("rejects stale metadata after external %s replacement", async (field) => {
+		const h = fixture();
+		await h.login();
+		const before = await h.models.getAuth("openai");
+		await h.credentials.modify("openai", async (current) => ({
+			...(current as OAuthCredential),
+			[field]: "external",
+		}));
+		expect((await h.models.getAuth("openai"))?.oauthSessionId).not.toBe(before?.oauthSessionId);
+	});
+
+	it("preserves stored credentials when refresh fails", async () => {
+		const h = fixture();
+		await h.login();
+		await h.expire();
+		const before = await h.credentials.read("openai");
+		h.refresh.mockRejectedValueOnce(new Error("offline refresh failure"));
+		await expect(h.models.getAuth("openai")).rejects.toThrow(/OAuth refresh failed/);
+		expect(await h.credentials.read("openai")).toEqual(before);
+	});
+});
