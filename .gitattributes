# Asset source manifests must see identical checkout bytes on every platform.
* text=auto eol=lf
*.exe binary
*.dll binary
*.so binary
*.wasm binary
# Preserve generated third-party legal text and its manifest-recorded bytes.
src/neural-search/assets/*NOTICES* -text -whitespace
# Unified patch blank context lines contain a required single space.
src/neural-search/semantic/native/patches/*.patch whitespace=-blank-at-eol
# SDK patches also preserve upstream tabs and blank context lines at the end of a hunk.
sdk-patches/**/*.patch whitespace=-blank-at-eof,-blank-at-eol,-space-before-tab
