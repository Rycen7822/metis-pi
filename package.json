{
  "name": "@rycen7822/metis-pi",
  "version": "0.19.6",
  "description": "Display-only Codex-style compact transcript for Pi, including width-aware Codex diff surfaces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rycen7822/metis-pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./vendor/pi-codex-conversion/dist/index.js"
    ],
    "themes": [
      "./themes/metis-pi.json"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.mjs\" \"test/**/*.test.mts\"",
    "test:host": "node --experimental-strip-types scripts/host-smoke.mjs",
    "test:chrome": "node --experimental-strip-types --test \"test/chrome/*.test.mjs\" \"test/chrome/*.test.mts\"",
    "check": "tsc -p tsconfig.json",
    "check:core": "tsc -p tsconfig.core.json",
    "check:test": "tsc -p tsconfig.test.json",
    "verify": "npm run vendor:fresh && npm run check && npm run check:test && npm run vendor:check && npm test && npm run vendor:smoke && npm run test:host && npm pack --dry-run --ignore-scripts",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "test:pty": "node --experimental-strip-types scripts/pty-verify.mjs",
    "test:pty:strict": "node --experimental-strip-types scripts/pty-verify.mjs --strict",
    "vendor:build": "node scripts/vendor-codex-conversion.mjs build",
    "vendor:check": "node scripts/vendor-codex-conversion.mjs check",
    "vendor:patch": "node scripts/vendor-codex-conversion.mjs patch",
    "vendor:sync": "node scripts/vendor-codex-conversion.mjs sync",
    "vendor:smoke": "node --experimental-strip-types scripts/vendor-smoke.mjs",
    "vendor:fresh": "node scripts/vendor-codex-conversion.mjs build && node scripts/check-vendor-fresh.mjs"
  },
  "dependencies": {
    "marked": "18.0.11",
    "openai": "^7.10.0",
    "partial-json": "^0.1.7",
    "proxy-from-env": "^2.1.0",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.8.0",
    "undici": "^8.10.2",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "typescript": "5.9.3"
  },
  "files": [
    "extensions",
    "src",
    "themes",
    "README.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "docs",
    "vendor"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "codex",
    "appearance"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
