{
  "name": "@rycen7822/metis-pi",
  "version": "0.24.0",
  "description": "Codex-style terminal UI and workflow extensions for Pi, with context management, tool discovery, and subagents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rycen7822/metis-pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "themes": [
      "./themes/metis-pi.json"
    ],
    "skills": [
      "./skills",
      "!skills/subagent-delegation/SKILL.md"
    ]
  },
  "scripts": {
    "test": "node scripts/test.mjs all",
    "test:formal": "node test/formal/run.mjs",
    "test:fast": "node scripts/test.mjs core",
    "test:host": "node scripts/test.mjs host",
    "test:lsp": "node scripts/test.mjs lsp",
    "test:ask-user-question": "node scripts/test.mjs ask",
    "test:protocol": "node scripts/test.mjs protocol",
    "test:io": "node scripts/test.mjs io",
    "test:resource": "node scripts/test.mjs resource",
    "test:chrome": "node scripts/test.mjs chrome",
    "check": "npm run check:core && npm run check:execution && npm run check:condense && npm run check:plugins && npm run check:entries",
    "check:core": "node node_modules/tsc-native/bin/tsc -p config/typescript/core.json",
    "check:entries": "node node_modules/tsc-native/bin/tsc -p tsconfig.json",
    "check:test": "node node_modules/tsc-native/bin/tsc -p config/typescript/test.json",
    "lint:tests": "node node_modules/oxlint/bin/oxlint test src/pi-web-access/test",
    "lint:comments": "node node_modules/oxlint/bin/oxlint extensions src/pi-session-recall",
    "lint:types": "node scripts/lint-types.mjs",
    "verify": "npm run build:plugins && npm run prepare:subagents && npm run check && npm run check:test && npm test && npm run test:plugins && npm run test:subagents",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "test:pty": "node --experimental-strip-types scripts/pty-verify.mjs",
    "test:pty:strict": "node --experimental-strip-types scripts/pty-verify.mjs --strict",
    "check:execution": "node node_modules/tsc-native/bin/tsc -p config/typescript/execution.json",
    "check:condense": "node node_modules/tsc-native/bin/tsc -p config/typescript/condense.json",
    "prepare:subagents": "node --experimental-strip-types scripts/python.mjs scripts/prepare-subagents.py",
    "prepare": "npm run prepare:subagents",
    "postinstall": "node src/pi-sdk/install.mjs && node src/neural-search/runtime/install.mjs && node src/condense/refresh-prices.mjs",
    "build:pi-sdk": "node scripts/pi-sdk.mjs package",
    "verify:pi-sdk": "node scripts/pi-sdk.mjs verify",
    "prepare:pi-sdk": "node scripts/pi-sdk.mjs prepare",
    "build:neural-engine": "node scripts/neural-engine.mjs",
    "build:recall": "node scripts/build-session-recall.mjs",
    "verify:neural-engine": "node scripts/neural-engine.mjs verify",
    "verify:native-assets": "node scripts/verify-native-assets.mjs",
    "prepack": "npm run verify:pi-sdk && npm run verify:native-assets && npm run build:web-access && npm run prepare:subagents",
    "test:subagents": "node scripts/python.mjs -m pytest -q test/subagents -n 4 --dist=worksteal -o cache_dir=.work/test-cache/subagents",
    "build:web-access": "node scripts/build-web-access.mjs",
    "test:web-access": "node scripts/test.mjs web-access",
    "build:plugins": "npm run build:web-access",
    "test:plugins": "npm run test:web-access",
    "check:plugins": "node node_modules/tsc-native/bin/tsc -p src/pi-web-access && node node_modules/tsc-native/bin/tsc -p src/pi-session-recall"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.7.0",
    "@earendil-works/pi-mcp": "1.7.0",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.9.0",
    "tiktoken": "1.0.22",
    "tar": "7.5.22",
    "undici": "8.12.4",
    "web-tree-sitter": "^0.27.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "optionalDependencies": {
    "ffi-rs": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.7.0",
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "@interfere/landmines": "0.1.1",
    "@types/node": "^22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "oxlint": "1.94.0",
    "tsc-native": "npm:typescript@7.0.2",
    "tsrs": "7.1.0-beta.tsrs3",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "$undici"
    }
  },
  "allowScripts": {
    "@google/genai@2.32.0": false,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": false
  },
  "files": [
    "metis-pi.toml",
    "metis-pi-config.md",
    "extensions",
    "src",
    "!src/neural-search/engine/**",
    "!src/neural-search/semantic/**",
    "!src/local-embedding/**",
    "!src/pi-session-recall/native/**",
    "!src/**/test/**",
    "!src/**/*.test.*",
    "!src/**/scripts/**",
    "!src/**/evidence/**",
    "!src/**/AGENTS.md",
    "!src/**/tsconfig*.json",
    "skills",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "docs/**/*.md",
    "sdk-patches",
    "docs/provenance/execution/LICENSE",
    "docs/provenance/execution/musl-NOTICES",
    "docs/provenance/condense/LICENSE",
    "docs/provenance/mcp/LICENSE",
    "vendor/tree-sitter-bash",
    "assets/native-tools",
    "assets/pi-sdk",
    "docs/provenance/subagents/LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "codex",
    "appearance"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "bin": {
    "pi-web-access-mcp": "src/pi-web-access/dist/mcp-cli.js"
  }
}
