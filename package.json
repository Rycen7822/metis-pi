{
  "name": "@rycen7822/metis-pi",
  "version": "0.21.0",
  "description": "Display-only Codex-style compact transcript for Pi, including width-aware Codex diff surfaces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rycen7822/metis-pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "themes": [
      "./themes/metis-pi.json"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node scripts/test.mjs all",
    "test:fast": "node scripts/test.mjs core",
    "test:host": "node scripts/test.mjs host",
    "test:lsp": "node scripts/test.mjs lsp",
    "test:ask-user-question": "node scripts/test.mjs ask",
    "test:protocol": "node scripts/test.mjs protocol",
    "test:io": "node scripts/test.mjs io",
    "test:resource": "node scripts/test.mjs resource",
    "test:chrome": "node scripts/test.mjs chrome",
    "check": "npm run check:core && npm run check:execution && npm run check:condense && npm run check:plugins && npm run check:entries",
    "check:core": "tsc -p tsconfig.core.json",
    "check:entries": "tsc -p tsconfig.json",
    "check:test": "tsc -p tsconfig.test.json",
    "verify": "npm run build:plugins && npm run prepare:subagents && npm run check && npm run check:test && npm test && npm run test:plugins && npm run test:subagents",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "test:pty": "node --experimental-strip-types scripts/pty-verify.mjs",
    "test:pty:strict": "node --experimental-strip-types scripts/pty-verify.mjs --strict",
    "check:execution": "tsc -p tsconfig.execution.json",
    "check:condense": "tsc -p tsconfig.condense.json",
    "prepare:subagents": "python3 scripts/prepare-subagents.py",
    "prepare": "npm run prepare:subagents",
    "prepack": "npm run build:plugins && npm run prepare:subagents",
    "test:subagents": "PYTHONDONTWRITEBYTECODE=1 python3 -m pytest -q test/subagents -n 4 --dist=loadfile",
    "build:plugins": "npm --prefix src/pi-web-access run build",
    "test:plugins": "npm --prefix src/pi-web-access test",
    "check:plugins": "tsc -p src/pi-web-access/tsconfig.json && tsc -p src/pi-session-recall/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "1.3.0",
    "marked": "18.0.11",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.9.0",
    "tiktoken": "1.0.22",
    "undici": "8.11.2",
    "web-tree-sitter": "^0.27.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "vitest": "4.1.10"
  },
  "files": [
    "metis-pi.toml",
    "metis-pi-config.md",
    "extensions",
    "src",
    "!src/ask-user-question/**/*.test.ts",
    "!src/ask-user-question/test-fixtures.ts",
    "skills",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "docs/**/*.md",
    "docs/provenance/execution/LICENSE",
    "docs/provenance/execution/musl-NOTICES",
    "docs/provenance/condense/LICENSE",
    "docs/provenance/mcp/LICENSE",
    "vendor/tree-sitter-bash",
    "assets/native-tools",
    "docs/provenance/subagents/LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "codex",
    "appearance"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "bin": {
    "pi-web-access-mcp": "src/pi-web-access/dist/mcp-cli.js"
  }
}
