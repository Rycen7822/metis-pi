{
  "name": "@rycen7822/metis-pi",
  "version": "0.19.6",
  "description": "Display-only Codex-style compact transcript for Pi, including width-aware Codex diff surfaces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rycen7822/metis-pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./vendor/pi-codex-conversion/dist/index.js"
    ],
    "themes": [
      "./themes/metis-pi.json"
    ]
  },
  "scripts": {
    "test": "node scripts/test.mjs all",
    "test:fast": "node scripts/test.mjs core",
    "test:host": "node scripts/test.mjs host",
    "test:protocol": "node scripts/test.mjs protocol",
    "test:io": "node scripts/test.mjs io",
    "test:resource": "node scripts/test.mjs resource",
    "test:chrome": "node scripts/test.mjs chrome",
    "check": "tsc -p tsconfig.json",
    "check:core": "tsc -p tsconfig.core.json",
    "check:test": "tsc -p tsconfig.test.json",
    "verify": "npm run check && npm run check:test && npm run vendor:check && npm test && npm pack --dry-run --ignore-scripts",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "test:pty": "node --experimental-strip-types scripts/pty-verify.mjs",
    "test:pty:strict": "node --experimental-strip-types scripts/pty-verify.mjs --strict",
    "vendor:build": "npm run vendor:check",
    "vendor:check": "tsc -p vendor/pi-codex-conversion/tsconfig.json && tsc -p vendor/pi-condense/tsconfig.json",
    "vendor:smoke": "node --experimental-strip-types --test test/contract/vendor-codex-registration.test.mjs",
    "vendor:fresh": "npm run vendor:check"
  },
  "dependencies": {
    "marked": "18.0.11",
    "openai": "^7.10.0",
    "proxy-from-env": "^2.1.0",
    "smol-toml": "^1.8.0",
    "undici": "^8.10.2",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "files": [
    "extensions",
    "src",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "docs",
    "vendor/pi-codex-conversion/{package.json,changelog.js,CHANGELOG.md,LICENSE,PATCHES.md,UPSTREAM.md}",
    "vendor/pi-codex-conversion/dist/*.js",
    "vendor/pi-codex-conversion/src/**/*.ts",
    "!vendor/pi-codex-conversion/src/tools/rust/**",
    "vendor/pi-codex-conversion/changelog.ts",
    "vendor/pi-codex-conversion/vendor",
    "vendor/pi-codex-conversion/src/tools/*/bin/**",
    "vendor/pi-codex-conversion/src/tools/code-mode/CUSTOM-TOOLS.md",
    "vendor/pi-codex-conversion/code-mode/bin",
    "vendor/pi-codex-conversion/code-mode/vendor/code-mode-src/{LICENSE,NOTICE,UPSTREAM}",
    "vendor/pi-condense/{package.json,LICENSE,PATCHES.md,UPSTREAM.md}",
    "vendor/pi-condense/dist/index.js",
    "vendor/pi-condense/index.ts",
    "vendor/pi-condense/src/**/*.ts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "codex",
    "appearance"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": ">=0.87.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
