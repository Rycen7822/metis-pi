+// Serialize the counter and the pool transition together: End racing a new Begin
+// must not disable an active peer or leave an idle pool spinning.
+void OrtEnv::SetSgrepPoolSpinning(bool enabled) {
+  for (auto* pool : {value_->GetIntraOpThreadPool(), value_->GetInterOpThreadPool()}) {
+    if (pool) {
+      if (enabled) pool->EnableSpinning();
+      else pool->DisableSpinning();
+    }
+  }
+}
+
+bool OrtEnv::EnableSgrepRunSpinning() {
+  std::lock_guard<std::mutex> lock(sgrep_spin_mutex_);
+  if (!value_->EnvCreatedWithGlobalThreadPools()) return false;
+  sgrep_run_spinning_ = true;
+  if (sgrep_active_runs_ == 0) SetSgrepPoolSpinning(false);
+  return true;
+}
+
+bool OrtEnv::BeginSgrepRunSpinning(const onnxruntime::Environment& expected) {
+  std::lock_guard<std::mutex> lock(sgrep_spin_mutex_);
+  if (!sgrep_run_spinning_ || &expected != value_.get()) return false;
+  if (sgrep_active_runs_++ == 0) SetSgrepPoolSpinning(true);
+  return true;
+}
+
+void OrtEnv::EndSgrepRunSpinning() {
+  std::lock_guard<std::mutex> lock(sgrep_spin_mutex_);
+  ORT_ENFORCE(sgrep_active_runs_ > 0, "Unbalanced Env Run spin scope");
+  if (--sgrep_active_runs_ == 0) SetSgrepPoolSpinning(false);
+}
+
+uint64_t OrtEnv::SgrepActiveRuns() const {
+  std::lock_guard<std::mutex> lock(sgrep_spin_mutex_);
+  return sgrep_active_runs_;
+}
+
+extern "C" ORT_EXPORT ORT_API_STATUS_IMPL(OrtSgrepEnableRunScopedSpinning, OrtEnv* env) {
+  API_IMPL_BEGIN
+  if (!env || !env->EnableSgrepRunSpinning()) {
+    return OrtApis::CreateStatus(ORT_INVALID_ARGUMENT, "Run-scoped spinning requires an Env with global pools");
+  }
+  return nullptr;
+  API_IMPL_END
+}
+
+extern "C" ORT_EXPORT ORT_API_STATUS_IMPL(OrtSgrepGetActiveRunCount, const OrtEnv* env, uint64_t* active) {
+  API_IMPL_BEGIN
+  if (!env || !active) return OrtApis::CreateStatus(ORT_INVALID_ARGUMENT, "Env and active-run output are required");
+  *active = env->SgrepActiveRuns();
+  return nullptr;
+  API_IMPL_END
+}
+
 void OrtEnv::SetLoggingManager(std::unique_ptr<onnxruntime::logging::LoggingManager> logging_manager) {
