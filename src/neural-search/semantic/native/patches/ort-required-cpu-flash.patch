@@ -5,6 +5,57 @@
 #include "core/framework/allocator.h"
 #include "core/framework/bfc_arena.h"
 #include <type_traits>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace {
+// Explicit development trace only. Never stores tokens, text or tensor data.
+// The sequential CPU graph has one active node; its workers share this tag.
+struct SgrepAllocationTrace {
+  FILE* file = nullptr;
+  std::mutex mutex;
+  int64_t node = -1;
+  uint64_t sequence = 0;
+  SgrepAllocationTrace() {
+    if (const char* path = std::getenv("SGREP_ALLOCATION_TRACE")) {
+      file = std::fopen(path, "w");
+      if (!file) std::fprintf(stderr, "SGREP: cannot open requested allocation trace\n");
+    }
+  }
+  ~SgrepAllocationTrace() { if (file) std::fclose(file); }
+  void SetNode(int64_t next) {
+    if (!file) return;
+    std::lock_guard<std::mutex> guard(mutex);
+    const int64_t previous = node;
+    node = next;
+    std::fprintf(file, "{\"seq\":%llu,\"kind\":\"node_%s\",\"node\":%lld}\n",
+                 static_cast<unsigned long long>(++sequence), next < 0 ? "end" : "begin",
+                 static_cast<long long>(next < 0 ? previous : next));
+  }
+  void Mark(const char* name, uint64_t value) {
+    if (!file) return;
+    std::lock_guard<std::mutex> guard(mutex);
+    // name is a fixed literal from our adapter, not user/model input.
+    std::fprintf(file, "{\"seq\":%llu,\"kind\":\"marker\",\"name\":\"%s\",\"value\":%llu,\"node\":%lld}\n",
+                 static_cast<unsigned long long>(++sequence), name, static_cast<unsigned long long>(value), static_cast<long long>(node));
+  }
+  void Allocation(const char* kind, const void* arena, const void* ptr,
+                  size_t requested, size_t allocated, int64_t used, int64_t held) {
+    if (!file) return;
+    std::lock_guard<std::mutex> guard(mutex);
+    std::fprintf(file, "{\"seq\":%llu,\"kind\":\"%s\",\"arena\":\"%p\",\"ptr\":\"%p\","
+                 "\"node\":%lld,\"requested\":%llu,\"allocated\":%llu,\"in_use\":%lld,\"held\":%lld}\n",
+                 static_cast<unsigned long long>(++sequence), kind, arena, ptr, static_cast<long long>(node),
+                 static_cast<unsigned long long>(requested), static_cast<unsigned long long>(allocated),
+                 static_cast<long long>(used), static_cast<long long>(held));
+  }
+};
+SgrepAllocationTrace& SgrepTrace() { static SgrepAllocationTrace trace; return trace; }
+}  // namespace
+extern "C" void OrtSgrepTraceNode(int64_t node) { SgrepTrace().SetNode(node); }
+extern "C" void OrtSgrepTraceMarker(const char* name, uint64_t value) { SgrepTrace().Mark(name, value); }
 
