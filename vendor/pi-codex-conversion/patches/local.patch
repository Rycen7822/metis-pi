+		this.memory = "";
+	}
+
+	private closeSpool(): void {
+		const spool = this.spool;
+		if (!spool) return;
+		this.spool = undefined;
+		try {
+			fs.closeSync(spool.fd);
+		} finally {
+			fs.rmSync(spool.directory, { recursive: true, force: true });
+		}
+	}
+}
