{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "lib": ["ES2022"], "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
